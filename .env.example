# Copy to .env and fill in real values for anything beyond local dev.
# .env is gitignored -- nothing here is a real secret, only local-dev
# placeholders documented so a new engineer knows every variable that
# exists. See docs/RUNBOOK.md.

# --- Backend (apps/api) ---------------------------------------------------

OPERATOROS_ENV=local

# Postgres. The app connects as operatoros_app (non-superuser,
# non-BYPASSRLS -- see infra/postgres/init/01-roles.sql). Migrations run
# as operatoros_admin (the docker-compose bootstrap superuser).
OPERATOROS_DATABASE_URL=postgresql+asyncpg://operatoros_app:operatoros_app_dev_only@localhost:5432/operatoros
OPERATOROS_DATABASE_URL_MIGRATE=postgresql+psycopg://operatoros_admin:operatoros_admin_dev_only@localhost:5432/operatoros

OPERATOROS_REDIS_URL=redis://localhost:6379/0

# JWT access tokens (15 min TTL) and the Fernet key used to encrypt small
# secrets at rest (TOTP seeds today; mobile-money/EBM credentials later).
# Generate real values for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
OPERATOROS_JWT_SECRET=local-dev-only-secret-change-me-please
OPERATOROS_SECRET_ENCRYPTION_KEY=3OIG0lvVcsGpLImnOWQHs7HqnEhJXlwvHfK7hewA1vg=

OPERATOROS_ACCESS_TOKEN_TTL_MINUTES=15
OPERATOROS_REFRESH_TOKEN_TTL_DAYS=30
OPERATOROS_DEVICE_TRUST_TTL_DAYS=30
OPERATOROS_SESSION_IDLE_TIMEOUT_HOURS=12

OPERATOROS_MAX_LOGIN_ATTEMPTS=3
OPERATOROS_LOCKOUT_MINUTES=15
OPERATOROS_LOGIN_RATE_LIMIT_PER_MINUTE=10

OPERATOROS_IDEMPOTENCY_TTL_HOURS=24

OPERATOROS_LOG_LEVEL=INFO
