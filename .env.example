# Copy this file to .env and fill in real values.
# prisma.config.ts loads this via `import "dotenv/config"`.

# --- Database -----------------------------------------------------------
# Local dev: `npx prisma dev` runs a real local Postgres and prints a
# connection string you can paste here.
# Production: create a free Postgres on https://neon.tech or
# https://supabase.com and paste its connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- Auth -----------------------------------------------------------------
# Single-owner password gate (no user accounts). Generate a secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=""
# The password you type in at /login. Change this before deploying.
OWNER_PASSWORD=""

# --- WhatsApp Cloud API ---------------------------------------------------
# From a Meta developer app (developers.facebook.com) with the WhatsApp
# product added, plus a verified business phone number.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Secret from the same app's Basic Settings — used to verify webhook signatures.
WHATSAPP_APP_SECRET=""
# Any string you choose; enter the same value when you register the webhook
# URL in the Meta app dashboard.
WHATSAPP_VERIFY_TOKEN=""
# Optional, defaults to v21.0
WHATSAPP_API_VERSION="v21.0"

# --- MTN Mobile Money (Collections API) -----------------------------------
# From momodeveloper.mtn.com: subscribe to the "Collection" product for the
# subscription key, then create a sandbox API user + key.
MOMO_SUBSCRIPTION_KEY=""
MOMO_API_USER=""
MOMO_API_KEY=""
# "sandbox" or "production"
MOMO_ENVIRONMENT="sandbox"
# Optional override; defaults based on MOMO_ENVIRONMENT.
# MOMO_BASE_URL=""
# Public URL MTN can POST payment outcomes to (e.g. an ngrok tunnel in dev,
# or https://yourapp.com/api/webhooks/momo in production). Without this,
# payments only update when you poll `syncMomoPayment`.
# MOMO_CALLBACK_URL="https://yourapp.com/api/webhooks/momo"
# Shared secret appended to the callback URL — MTN doesn't sign callbacks,
# so this is what verifies a callback actually came from your MTN setup.
# MOMO_CALLBACK_SECRET=""
